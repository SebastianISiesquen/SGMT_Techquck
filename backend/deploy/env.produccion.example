# Copie como /var/www/sggp/backend/.env en el servidor y complete los valores.
APP_NAME="SGGP Techquk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sggp.techquk.com.pe
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgmt_techquk
DB_USERNAME=sggp
DB_PASSWORD=CAMBIE_ESTA_CLAVE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Documentos y evidencias: 'local' guarda en storage/app/private del servidor.
# Para guardarlos en la nube use 's3' y complete AWS_* (S3, Cloudflare R2 o DigitalOcean Spaces).
ARCHIVOS_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Correo para alertas de vencimiento y asignaciones (opcional; sin esto solo se usan notificaciones internas)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sggp@techquk.com.pe"
MAIL_FROM_NAME="${APP_NAME}"

# Usuario administrador inicial (se crea con: php artisan db:seed --force)
ADMIN_EMAIL=admin@techquk.com.pe
ADMIN_PASSWORD=CAMBIE_ESTA_CLAVE
